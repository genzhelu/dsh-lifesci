{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-lifesci.local/schemas/figures.schema.json",
  "title": "lifesci.figures payload",
  "description": "Rendered figures and/or PyMOL session build result.",
  "type": "object",
  "required": ["out_dir", "figures", "pymol", "sources"],
  "properties": {
    "out_dir": { "type": "string" },
    "dry_run": { "type": "boolean" },
    "planned": {
      "type": "array",
      "description": "dry-run: planned figure/session kinds without rendering.",
      "items": { "type": "object", "additionalProperties": true }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256", "bytes", "n_points"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["covariance_loglog", "length_histogram", "contact_bars"]
          },
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "n_points": { "type": "integer", "minimum": 0 },
          "regression": {
            "type": ["object", "null"],
            "description": "Log-log fit parameters drawn on the figure (slope/intercept/r2/n/pearson).",
            "additionalProperties": true
          },
          "title": { "type": ["string", "null"] },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "pymol": {
      "type": ["object", "null"],
      "description": "PyMOL session build result; null when no pymol_spec was supplied.",
      "properties": {
        "session": {
          "type": "object",
          "properties": {
            "pml_path": { "type": ["string", "null"] },
            "pse_path": { "type": ["string", "null"] },
            "rendered": { "type": "boolean" },
            "validation": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
                "checks": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "validation": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] }
          },
          "additionalProperties": true
        },
        "warnings": { "type": "array", "items": {} },
        "spec": { "type": "object" }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "description": "Input tables/stats used to render figures (path, sha256, bytes, role).",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "role": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
