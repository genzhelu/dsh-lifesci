{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-lifesci.local/schemas/orthology.schema.json",
  "title": "lifesci.orthology payload",
  "description": "Per-protein orthology records from PANTHER/OrthoDB/eggNOG/OMA with a pairwise cross-check table.",
  "type": "object",
  "required": ["proteins", "cross_checks", "resolved"],
  "properties": {
    "dry_run": { "type": "boolean" },
    "requested": { "type": "object" },
    "planned_requests": { "type": "array", "items": { "type": "object" } },
    "proteins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["accession", "agreement"],
        "properties": {
          "accession": { "type": "string" },
          "protein_name": { "type": ["string", "null"] },
          "genes": { "type": "array", "items": { "type": "string" } },
          "organism": { "type": "object" },
          "release": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "expected_claim": { "type": "array", "items": { "type": "string" } },
          "agreement": {
            "type": "string",
            "enum": ["agree", "disagree", "unknown"],
            "description": "Overall cross-source agreement; disagreement is flagged, single-source agreement is unknown confidence."
          },
          "panther": { "$ref": "#/$defs/source" },
          "orthodb": { "$ref": "#/$defs/source" },
          "eggnog": { "$ref": "#/$defs/source" },
          "oma": { "$ref": "#/$defs/source" },
          "cross_checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
        },
        "additionalProperties": true
      }
    },
    "cross_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "resolved": {
      "type": "object",
      "required": ["cache_dir", "n_proteins", "n_agree", "n_disagree", "n_unknown"],
      "properties": {
        "cache_dir": { "type": "string" },
        "out_dir": { "type": ["string", "null"] },
        "n_proteins": { "type": "integer", "minimum": 0 },
        "n_agree": { "type": "integer", "minimum": 0 },
        "n_disagree": { "type": "integer", "minimum": 0 },
        "n_unknown": { "type": "integer", "minimum": 0 },
        "sources_requested": { "type": "array", "items": { "type": "string" } },
        "sources_unavailable": { "type": "array", "items": { "type": "string" } },
        "releases": { "type": "object" }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "accession": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "source": {
      "type": ["object", "null"],
      "required": ["source", "available"],
      "properties": {
        "source": { "type": "string" },
        "available": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "identifiers": { "type": "array", "items": { "type": "string" } },
        "labels": { "type": "array", "items": { "type": "string" } },
        "claim": { "type": "array", "items": { "type": "string" } },
        "agreement": { "type": "string", "enum": ["agree", "disagree", "unknown"] },
        "details": { "type": "object" }
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["accession", "a", "b", "agreement"],
      "properties": {
        "accession": { "type": "string" },
        "a": { "type": "string" },
        "b": { "type": "string" },
        "agreement": { "type": "string", "enum": ["agree", "disagree", "unknown"] },
        "detail": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
